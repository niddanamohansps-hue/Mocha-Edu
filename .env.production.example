# ==============================================================
# School Sansar - Production Environment Template (.env.production)
# Copy this file to .env.production and fill in your real secrets.
# Do NOT commit .env.production to version control!
# ==============================================================

# --------------------------------------------------------------
# 1. Django Core & Security Secrets
# --------------------------------------------------------------
DEBUG=False
# Generate a strong 50+ character key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-in-production

# Encryption key for sensitive database columns (Aadhaar, API secrets)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-this-to-a-valid-fernet-encryption-key-for-database-fields

# Hostnames allowed to connect (wildcard subdomains supported)
ALLOWED_HOSTS=.schoolsansar.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://schoolsansar.com,https://*.schoolsansar.com,http://*.localhost

# HTTPS redirect. Keep True once TLS works; set both to False only for a plain-HTTP trial (see deploy/README.md).
SECURE_SSL_REDIRECT=True
USE_SECURE_PROXY_SSL_HEADER=True
# Serve private downloads through nginx (X-Accel-Redirect) instead of streaming them through Django.
USE_X_ACCEL_REDIRECT=True

# --------------------------------------------------------------
# 2. PostgreSQL Relational Database Configuration
# --------------------------------------------------------------
DB_NAME=schoolsansar_production
DB_USER=schoolsansar_pguser
DB_PASSWORD=choose-a-strong-database-password-here
DB_HOST=db
DB_PORT=5432

# --------------------------------------------------------------
# 3. Redis Cache & Celery Background Task Worker
# --------------------------------------------------------------
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_CONCURRENCY=4

# --------------------------------------------------------------
# 4. Frontend Next.js Configuration
# --------------------------------------------------------------
# Compiled into the browser bundle at build time: true = browser calls /api on the same host as the page.
NEXT_PUBLIC_API_SAME_ORIGIN=true

# --------------------------------------------------------------
# 5. Payment Gateway (Razorpay SaaS & Fee Collection)
# --------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_actual_razorpay_webhook_secret

# --------------------------------------------------------------
# 6. Email / SMTP Dispatch Configuration
# --------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_smtp_api_key_or_password
DEFAULT_FROM_EMAIL=School Sansar <notifications@schoolsansar.com>

# --------------------------------------------------------------
# 7. Gunicorn Concurrency
# --------------------------------------------------------------
WEB_CONCURRENCY=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=90
