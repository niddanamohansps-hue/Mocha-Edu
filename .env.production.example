# ==============================================================
# School Sansar - Production Environment Template (.env.production)
# Copy this file to .env.production and fill in your real secrets.
# Do NOT commit .env.production to version control!
# ==============================================================

# --------------------------------------------------------------
# 1. Django Core & Security Secrets
# --------------------------------------------------------------
DEBUG=False
# Generate a strong 50+ character key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-in-production

# Encryption key for sensitive database columns (Aadhaar, API secrets)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-this-to-a-valid-fernet-encryption-key-for-database-fields

# Hostnames allowed to connect (wildcard subdomains supported)
ALLOWED_HOSTS=.schoolsansar.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://schoolsansar.com,https://*.schoolsansar.com,http://*.localhost

# Keys that seal issued certificates. The app refuses to start without them when DEBUG=False.
# Format "id:secret"; generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep retired keys listed until no issued certificate still uses them.
CERTIFICATE_INTEGRITY_KEYS=1:change-this-to-a-long-random-secret
CERTIFICATE_INTEGRITY_ACTIVE_KEY=1

# The school's calendar day for dates, fee days and the day book (e.g. Asia/Kolkata for India).
ALERT_TIME_ZONE=Asia/Kolkata

# Each new school gets <subdomain>.TENANT_BASE_DOMAIN. Use your real domain.
TENANT_BASE_DOMAIN=edusekai.example
TENANT_LOGIN_URL_TEMPLATE=https://{domain}/login

# Browser push notifications (free). Generate once: python -m py_vapid --gen  (or any VAPID key generator)
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# HTTPS redirect. Keep True once TLS works; set both to False only for a plain-HTTP trial (see deploy/README.md).
SECURE_SSL_REDIRECT=True
USE_SECURE_PROXY_SSL_HEADER=True
# Serve private downloads through nginx (X-Accel-Redirect) instead of streaming them through Django.
USE_X_ACCEL_REDIRECT=True

# --------------------------------------------------------------
# 2. PostgreSQL Relational Database Configuration
# --------------------------------------------------------------
DB_NAME=schoolsansar_production
DB_USER=schoolsansar_pguser
DB_PASSWORD=choose-a-strong-database-password-here
DB_HOST=db
DB_PORT=5432

# --------------------------------------------------------------
# 3. Redis Cache & Celery Background Task Worker
# --------------------------------------------------------------
REDIS_CACHE_URL=redis://redis:6379/1
# Names this deployment inside Redis (System Health counters are kept per environment). Give every environment
# that could share a Redis its own value, e.g. production / staging.
DEPLOYMENT_ENVIRONMENT=production
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_CONCURRENCY=4

# --------------------------------------------------------------
# 4. Frontend Next.js Configuration
# --------------------------------------------------------------
# Compiled into the browser bundle at build time: true = browser calls /api on the same host as the page.
NEXT_PUBLIC_API_SAME_ORIGIN=true

# Optional CAPTCHA (Cloudflare Turnstile) on the public careers form. Create a free widget in the Cloudflare
# dashboard; the site key is public and compiled into the frontend, the secret stays on the backend. Leave both
# empty to run without it (the rate limit and a hidden spam-trap field still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp alerts (Meta WhatsApp Business Cloud API). Leave the provider as "disabled" to send nothing, use
# "console" to only log messages while developing, and "meta" for real delivery. The template names must match
# templates approved in the Meta dashboard (category: utility). Parents only receive messages once the school has
# recorded their opt-in on the parent record.
WHATSAPP_PROVIDER=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_FEE_DUE=fee_due_reminder
WHATSAPP_TEMPLATE_FEE_OVERDUE=fee_overdue_reminder
WHATSAPP_TEMPLATE_ABSENCE=absence_alert
WHATSAPP_TEMPLATE_DATE_SHEET=exam_date_sheet

# --------------------------------------------------------------
# 5. Payment Gateway (Razorpay SaaS & Fee Collection)
# --------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_actual_razorpay_webhook_secret

# --------------------------------------------------------------
# 6. Email / SMTP Dispatch Configuration
# --------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_smtp_api_key_or_password
DEFAULT_FROM_EMAIL=School Sansar <notifications@schoolsansar.com>

# --------------------------------------------------------------
# 7. Gunicorn Concurrency
# --------------------------------------------------------------
WEB_CONCURRENCY=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=90
