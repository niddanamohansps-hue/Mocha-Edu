# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,backend

# Key for encrypting secrets at rest (temporary account passwords held for
# one-time admin distribution, and the signup password held by Payment
# until a transaction completes) - see accounts/utils/crypto.py.
# REQUIRED when DEBUG=False (the app will refuse to start without it).
# Kept independent of SECRET_KEY so it can be rotated without breaking
# decryption of already-encrypted values. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=your-generated-fernet-key-here

# Certificate integrity keys. REQUIRED when DEBUG=False. Format: id:secret[,id:secret]
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# To rotate: add a new id:secret pair, point ACTIVE_KEY at the new id, keep the old pair
# listed until no certificate references it. Never reuse an id for a different secret.
# CERTIFICATE_INTEGRITY_KEYS=1:replace-with-a-long-random-secret
# CERTIFICATE_INTEGRITY_ACTIVE_KEY=1
# CERTIFICATE_ACCEPT_LEGACY_SEALS=True
# ID_CARD_ACCEPT_LEGACY_TOKENS=True

# Database
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=db
DB_PORT=5432
DATABASE=postgres

# Environment identity.
# EDUSEKAI_ENV is a free label (letters, digits, '_', '.', '-'; up to 32 characters)
# used in the database application_name. EDUSEKAI_EXPECTED_DATABASE declares the
# database this environment must use, as name@host:port, and is compared literally
# with DB_NAME / DB_HOST / DB_PORT (so 127.0.0.1 and localhost are different).
# Use the values of THIS environment. It produces a startup warning when it does not
# match, and it is REQUIRED to apply migrations: the migration gate in manage.py
# refuses an apply unless it is set and matches exactly (no test_ exception).
# EDUSEKAI_ENV=development
# EDUSEKAI_EXPECTED_DATABASE=your_db_name@db:5432

# Docker only: apply migrations when the backend container starts. Off by default;
# only the exact value "true" opts in. Prefer a deliberate one-off run instead (see
# the "Migration safety" section of README.md).
RUN_MIGRATIONS_ON_START=false

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=1

# JWT cookie security.
# Defaults to True when DEBUG=False and False when DEBUG=True.
COOKIE_SECURE=False

# Email (password reset, etc.)
# Console backend prints emails to the server's terminal - nothing else
# to configure for local dev. Switch to SMTP below for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@edusekai.local
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

# Password reset
# How long a reset link stays valid (seconds). Default: 1 hour.
PASSWORD_RESET_TIMEOUT_SECONDS=3600
# Protocol/port for the reset link sent by email - the hostname itself is
# always the tenant subdomain the request came in on, never set here.
# Defaults to http when DEBUG=True and https when DEBUG=False.
# PASSWORD_RESET_FRONTEND_PROTOCOL=https
PASSWORD_RESET_FRONTEND_PORT=3555

# Celery (async email outbox - requires a Redis server and a running
# `celery -A config worker` process; see notifications/tasks.py)
# DB index 3 (not 0) and a dedicated queue name - if your local Redis is
# shared with any other project, this avoids consuming/colliding with its
# tasks (and vice versa). Change the index if 3 is already taken too.
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_DEFAULT_QUEUE=edusekai

# Django Cache (Shared multi-worker DRF throttling and caching)
# Uses Redis DB index 4 by default, keeping it isolated from Celery (DB 3).
REDIS_CACHE_URL=redis://localhost:6379/4

# HTTPS, TLS & Security Headers (Production Hardening)
# SECURE_SSL_REDIRECT=True
# USE_SECURE_PROXY_SSL_HEADER=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# HSTS: Keep 0 until production HTTPS setup is verified
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# CSRF_TRUSTED_ORIGINS=https://*.edusekai.com,https://edusekai.com

# Private Media Delivery (Nginx X-Accel-Redirect)
# Offloads private media streaming from Gunicorn to Nginx after Django authorization
# USE_X_ACCEL_REDIRECT=True
# X_ACCEL_PREFIX=/protected_media/

# Antivirus Scanning (ClamAV Daemon)
# Enabled in production; fail-closed scanning for student document uploads
# CLAMAV_ENABLED=True
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=10
# CLAMAV_FAIL_CLOSED=True

# CORS
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOW_CREDENTIALS=True

# Superuser (dev only)
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=strong-password-here

# eSewa v2
ESEWA_CLIENT_SECRET=your-esewa-client-secret
ESEWA_PRODUCT_CODE=your-esewa-product-code
# Signup payment amount in NPR (plain decimal, e.g. 500 or 750.50). Defaults to 500.
ESEWA_SIGNUP_PAYMENT_AMOUNT=500

